# Managed by Ansible (ansible/roles/dns). Edit the role, not this file.
services:
  pihole:
    container_name: pihole
    image: {{ pihole_image }}
    network_mode: host  # Pi-hole sees each client's real IP
    environment:
      TZ: {{ pihole_timezone }}
      WEBPASSWORD_FILE: pihole_webpasswd  # a secret name, not a path
      FTLCONF_dns_upstreams: "{{ pihole_upstreams | join(';') }}"
      FTLCONF_dns_listeningMode: ALL  # answers other VLANs later; the firewall limits who can reach it
      FTLCONF_dns_dnssec: "false"  # Quad9 validates, and this avoids clock problems on a Pi with no RTC
      FTLCONF_webserver_port: "{{ pihole_web_port }}"
      FTLCONF_ntp_sync_active: "false"  # the host keeps the clock
      FTLCONF_ntp_ipv4_active: "false"
      FTLCONF_ntp_ipv6_active: "false"
      FTLCONF_database_DBinterval: "300"  # fewer SD card writes; a power cut can lose 5 minutes of history
      FTLCONF_database_maxDBdays: "30"
      FTLCONF_dns_queryLogging: "false"  # no pihole.log on the SD card; history stays in the database
      TAIL_FTL_LOG: "0"
    secrets:
      - pihole_webpasswd
    volumes:
      - ./etc-pihole:/etc/pihole
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: "3"
    restart: unless-stopped

secrets:
  pihole_webpasswd:
    file: ./pihole_webpasswd
