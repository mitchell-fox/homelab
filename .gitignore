# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local variable files can hold secrets; commit *.tfvars.example instead
*.tfvars
*.tfvars.json
!*.tfvars.example

# Secrets stay out of the public repo, even encrypted (ADR-0019)
secrets/*.sops.yaml
*.age
age.key
keys.txt
*.dec.yaml
*.dec.yml
*.decrypted.*
.env
.env.*

# Ansible
*.retry
.vault_pass*

# Kubernetes
kubeconfig
*.kubeconfig

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store

# Python
__pycache__/
*.pyc
